[Unit]
Description=Recover the previous Helios TUN network lease
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target
ConditionPathExists=/var/lib/helios/tun-route-lease.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/helios-helper --desktop-recover

[Install]
WantedBy=multi-user.target
