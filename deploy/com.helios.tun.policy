<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Helios</vendor>
  <action id="com.helios.tun">
    <description>Manage the Helios virtual network adapter</description>
    <description xml:lang="zh_CN">管理 Helios 虚拟网卡</description>
    <message>Administrator authorization is required to start or recover Helios TUN.</message>
    <message xml:lang="zh_CN">启用或恢复 Helios 虚拟网卡需要管理员授权。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/helios-helper</annotate>
  </action>
</policyconfig>
